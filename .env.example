# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 Git에 올리지 않습니다)
#   Windows: copy .env.example .env      Mac/Linux: cp .env.example .env

# Neon 콘솔 → Connection Details → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# STT 모델: tiny / base / small  (배포는 base 권장, 로컬 평가는 small)
STT_MODEL=base
STT_COMPUTE_TYPE=int8
