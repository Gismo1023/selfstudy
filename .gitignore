# =========================================================
# 2팀 AI 발음 교정·말하기 코치 — .gitignore
# =========================================================

# ---------- 1. 비밀정보 (절대 커밋 금지) ----------
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# ---------- 2. 음성 원본 (개인정보·동의 이슈) ----------
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.webm
*.aac
recordings/
uploads/
tmp_audio/
tts_cache/
# 시연용 TTS 폴백(합성음)은 커밋 허용
!assets/tts_fallback/*.mp3

# data/ 는 익명화 예시만 커밋 (문장 CSV 등은 허용)
data/raw/
data/eval/*
data/private/
!data/*.csv
!data/eval/manifest.csv
!data/README.md

# ---------- 3. 모델 파일 (용량·라이선스) ----------
models/*
!models/README.md
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
.cache/
huggingface/

# ---------- 4. Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------- 5. 가상환경 ----------
.venv/
venv/
env/
ENV/
.conda/

# ---------- 6. Jupyter ----------
.ipynb_checkpoints/

# ---------- 7. 로그·임시 파일 ----------
*.log
logs/
*.tmp
*.bak
*.swp

# ---------- 8. 에디터 / IDE ----------
.vscode/*
!.vscode/settings.json
.idea/
*.code-workspace

# ---------- 9. OS ----------
.DS_Store
Thumbs.db
desktop.ini
